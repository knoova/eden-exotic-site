# =============================================================================
# Eden Exotic — variabili d'ambiente (copiare in .env)
# Su Coolify: impostare queste variabili nell'interfaccia del progetto.
# =============================================================================

# --- Database (Postgres 18 + estensione pgvector) --------------------------
# UN SOLO URL: contiene utente, password, host, porta e nome del database.
# Il database vettoriale del RAG vive qui, nella stessa istanza (pgvector):
# nessun servizio separato. L'estensione `vector` viene creata in automatico
# al primo indice RAG (serve un utente con privilegio CREATE EXTENSION, oppure
# l'estensione già installata sull'immagine pgvector).
DATABASE_URL=postgresql://utente:password@host:5432/eden_exotic?schema=public

# --- AI locale (Ollama) ----------------------------------------------------
OLLAMA_URL=http://ollama:11434
# modello conversazionale
OLLAMA_CHAT_MODEL=llama3.2:3b
# modello per gli embedding del RAG
OLLAMA_EMBED_MODEL=nomic-embed-text
# dimensione dei vettori (deve combaciare con il modello di embedding e con la
# colonna vector(...) di pgvector). nomic-embed-text = 768.
EMBED_DIM=768

# --- Applicazione ----------------------------------------------------------
# passphrase dell'area amministrativa (cancello lato-server semplice)
ADMIN_PASSWORD=eden47
# segreto per firmare il cookie di sessione admin
ADMIN_SECRET=cambia_questo_segreto_lungo_e_casuale
NODE_ENV=production
# porta pubblicata dal container web
WEB_PORT=3000
