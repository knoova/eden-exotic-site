# =============================================================================
# Eden Exotic — variabili d'ambiente (copiare in .env)
# Su Coolify: impostare queste variabili nell'interfaccia del progetto.
# =============================================================================

# --- Database relazionale (Postgres) ---------------------------------------
POSTGRES_USER=eden
POSTGRES_PASSWORD=cambia_questa_password
POSTGRES_DB=eden_exotic
# URL usato da Prisma nel container "web" (host = nome servizio compose)
DATABASE_URL=postgresql://eden:cambia_questa_password@db:5432/eden_exotic?schema=public

# --- Database vettoriale (Qdrant) ------------------------------------------
QDRANT_URL=http://vector:6333
# opzionale: chiave API se abiliti l'auth su Qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=eden_canon

# --- AI locale (Ollama) ----------------------------------------------------
OLLAMA_URL=http://ollama:11434
# modello conversazionale (scaricato all'avvio dal servizio ollama-init)
OLLAMA_CHAT_MODEL=llama3.2:3b
# modello per gli embedding del RAG
OLLAMA_EMBED_MODEL=nomic-embed-text
# dimensione dei vettori di nomic-embed-text
EMBED_DIM=768

# --- Applicazione ----------------------------------------------------------
# passphrase dell'area amministrativa (cancello lato-server semplice)
ADMIN_PASSWORD=eden47
# segreto per firmare il cookie di sessione admin
ADMIN_SECRET=cambia_questo_segreto_lungo_e_casuale
NODE_ENV=production
